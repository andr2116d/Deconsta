ENTORNO=desarrollo
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/deconsta
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173"]
TIMEZONE=America/Lima
MIGRAR_AL_INICIAR=true
NIVEL_REGISTRO=INFO

# Claves de 32 bytes en base64, las tres distintas entre sí. Genera cada una con:
# python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Si se pierde CLAVE_CIFRADO_DATOS, los datos personales cifrados no se pueden recuperar.
CLAVE_CIFRADO_DATOS=
CLAVE_HUELLA_DATOS=
# Cifra los documentos antes de subirlos al bucket. Si se pierde, los archivos no se recuperan.
CLAVE_CIFRADO_ARCHIVOS=

# Bucket privado compatible con S3. En local, SeaweedFS de compose.yaml (docker/seaweedfs/s3.json).
# En Railway: los datos de la pestaña Credentials del bucket y S3_ESTILO_RUTA=false.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=deconsta
S3_ACCESS_KEY=dev
S3_SECRET_KEY=devsecret
S3_ESTILO_RUTA=true

# Revisión de documentos con Claude. En producción, IA_PROVEEDOR=api y la clave de la Claude Console
# (no de una suscripción). En desarrollo, IA_PROVEEDOR=claude_code usa la sesión de Claude Code de
# esta PC (comando claude con la sesión iniciada) y no necesita clave.
IA_PROVEEDOR=api
IA_COMANDO_CLAUDE_CODE=claude
ANTHROPIC_API_KEY=
IA_MODELO=claude-sonnet-5-5
IA_ESFUERZO=high
# Hilos de CPU de cada proceso del worker para PaddleOCR (núcleos / procesos). Vacío: los decide Paddle.
OCR_HILOS=

SESION_DURACION_MINUTOS=480
COOKIE_SESION_NOMBRE=deconsta_sesion
# false solo en desarrollo local sobre http; en producción debe ser true (HTTPS).
COOKIE_SEGURA=false

# Límites de frecuencia: solicitudes permitidas por ventana de segundos.
LIMITE_INGRESO_POR_ORIGEN=20
VENTANA_INGRESO_POR_ORIGEN_SEGUNDOS=60
LIMITE_INGRESO_POR_USUARIO=10
VENTANA_INGRESO_POR_USUARIO_SEGUNDOS=900
LIMITE_CAMBIO_CONTRASENA=5
VENTANA_CAMBIO_CONTRASENA_SEGUNDOS=900
LIMITE_DESBLOQUEO=20
VENTANA_DESBLOQUEO_SEGUNDOS=3600
LIMITE_ACTUALIZACION_CUENTA=10
VENTANA_ACTUALIZACION_CUENTA_SEGUNDOS=900
LIMITE_GESTION_EQUIPO=30
VENTANA_GESTION_EQUIPO_SEGUNDOS=3600
LIMITE_GESTION_CATEGORIAS=60
VENTANA_GESTION_CATEGORIAS_SEGUNDOS=3600
LIMITE_GESTION_REGLAS=60
VENTANA_GESTION_REGLAS_SEGUNDOS=3600
LIMITE_SUBIDA_DOCUMENTOS=30
VENTANA_SUBIDA_DOCUMENTOS_SEGUNDOS=3600
LIMITE_GESTION_DEUDAS=120
VENTANA_GESTION_DEUDAS_SEGUNDOS=3600
LIMITE_GESTION_PAGOS=120
VENTANA_GESTION_PAGOS_SEGUNDOS=3600
