ENTORNO=produccion
DOMINIO=${dominio}
POSTGRES_PASSWORD=${postgres}
DATABASE_URL=postgresql+psycopg://deconsta:${postgres}@postgres:5432/deconsta
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["https://${dominio}"]
TIMEZONE=America/Lima
MIGRAR_AL_INICIAR=true
NIVEL_REGISTRO=INFO
COOKIE_SEGURA=true
CLAVE_CIFRADO_DATOS=${clave_datos}
CLAVE_HUELLA_DATOS=${clave_huella}
CLAVE_CIFRADO_ARCHIVOS=${clave_archivos}
S3_ENDPOINT=https://s3.${region}.amazonaws.com
S3_REGION=${region}
S3_BUCKET=${bucket}
S3_ACCESS_KEY=${s3_access_key}
S3_SECRET_KEY=${s3_secret_key}
S3_ESTILO_RUTA=false
IA_PROVEEDOR=api
%{ if anthropic_api_key != "" ~}
ANTHROPIC_API_KEY=${anthropic_api_key}
%{ endif ~}
